# roblox-mac configuration. Copy to config.env (same directory as this file). Shell syntax.
# Every value here can also be given as an environment variable of the same name, which wins.

# Where the macOS Roblox client is (the x86_64 build; the folder that contains Contents/).
#ROBLOX_MAC_APP=/absolute/path/to/RobloxPlayer.app

# Darling prefix, logs written at runtime, shader cache. Defaults to RobloxLinuxDev/.build/profile.
#ROBLOX_MAC_DATA=/absolute/path/to/private-profile

# The optimized build uses native Wayland with GTK chrome and an embedded browser.
# Optional CPU affinity (comma-separated Linux CPU numbers). Leave unset for all allowed CPUs.
#ROBLOX_MAC_CPU_AFFINITY=0,1,2,3
# Optional presentation policy: 0 = no EGL vsync wait, 1 = synchronized.
# Default 0 avoids a second frame wait. Roblox keeps its own FPS cap.
# Host-native memory routines are enabled by default; set 0 to use Darling fallbacks.
#export TRACKA_NATIVE_MEMORY=0
#ROBLOX_MAC_SWAP_INTERVAL=0
# Pipeline compilation workers; default 8. Compilation remains off the render thread where possible.
#RBX_PIPELINE_WORKERS=8

# Metal -> Vulkan is the default and includes the login-control rendering fixes.
# Prepare its cache with bin/roblox-mac --prepare-shaders.
ROBLOX_MAC_RENDERER=metal

# Optional fixed game render size. Larger windows center the game without scaling;
# omit to render at the full window size. Embedded browser remains window-sized.
#ROBLOX_MAC_RENDER_SIZE=1512x949
