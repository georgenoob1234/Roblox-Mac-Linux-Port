# Sourced only by the final game launch. ROOT is the current directory/AppImage mount.
OPTIMIZED_LIBRARY_PATH=$G$ROOT/optimized/native/lib:$G$ROOT/optimized/renderer
OPTIMIZED_INSERT=$G$ROOT/optimized/renderer/libtracka-present.dylib:$G$ROOT/optimized/libtracka-compat.dylib:$G$ROOT/optimized/native/lib/libtracka-cpu.dylib:$G$ROOT/optimized/native/lib/libtracka-clock.dylib:$G$ROOT/optimized/native/lib/libtracka-memory.dylib:$G$ROOT/optimized/native/lib/librbxkqueue.dylib:$G$ROOT/optimized/native/lib/libtracka-taskinfo.dylib
