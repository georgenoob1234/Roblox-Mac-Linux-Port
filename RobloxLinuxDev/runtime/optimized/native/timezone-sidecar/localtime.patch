+/* Read under lcl_rwlock; only a successful load under its write lock commits. */
+static int
+tzfile_changed(const char *path)
+{
+	struct stat current;
+	return !path || stat(path, &current) != 0 || !last_tzload_valid ||
+		current.st_dev != last_tzload_stat.st_dev ||
+		current.st_ino != last_tzload_stat.st_ino ||
+		current.st_size != last_tzload_stat.st_size ||
+		current.st_mtimespec.tv_sec != last_tzload_stat.st_mtimespec.tv_sec ||
+		current.st_mtimespec.tv_nsec != last_tzload_stat.st_mtimespec.tv_nsec ||
+		current.st_ctimespec.tv_sec != last_tzload_stat.st_ctimespec.tv_sec ||
