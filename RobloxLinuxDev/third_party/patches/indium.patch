+namespace {
+PFN_vkAllocateMemory allocateMemory;
+PFN_vkFreeMemory freeMemory;
+struct AllocationLedger {
+    std::mutex mutex;
+    std::map<std::pair<VkDevice,VkDeviceMemory>,VkDeviceSize> allocations;
+    std::map<VkDevice,VkDeviceSize> totals;
+};
+AllocationLedger& ledger() {
+    // Kept through process teardown: GPU resource destructors may run very late.
+    static auto *value=new AllocationLedger;
+    return *value;
+}
+VkResult trackedAllocate(VkDevice device,const VkMemoryAllocateInfo *info,const VkAllocationCallbacks *callbacks,VkDeviceMemory *memory) {
+    auto result=allocateMemory(device,info,callbacks,memory);
+    if(result!=VK_SUCCESS)return result;
+    try {
+        auto& data=ledger();std::lock_guard lock(data.mutex);
+        auto& total=data.totals[device];
+        data.allocations.emplace(std::make_pair(device,*memory),info->allocationSize);
+        total+=info->allocationSize;
+    } catch(...) {
+        freeMemory(device,*memory,callbacks);*memory=VK_NULL_HANDLE;
+        return VK_ERROR_OUT_OF_HOST_MEMORY;
+    }
+    return result;
+}
+void trackedFree(VkDevice device,VkDeviceMemory memory,const VkAllocationCallbacks *callbacks) {
+    auto& data=ledger();
+    {
+        std::lock_guard lock(data.mutex);
+        auto found=data.allocations.find({device,memory});
+        if(found!=data.allocations.end()) {data.totals[device]-=found->second;data.allocations.erase(found);}
+    }
+    freeMemory(device,memory,callbacks);
+}
+}
+VkDeviceSize Indium::DynamicVK::allocatedSize(VkDevice device) {
+    auto& data=ledger();std::lock_guard lock(data.mutex);
+    auto found=data.totals.find(device);return found==data.totals.end() ? 0 : found->second;
+}
