+/// The corpus failure this family regresses: a `<4 x float>` load reading back the leading
+/// `<3 x float>` element of an `[N x <3 x float>]` allocation through an identity bitcast, with
+/// Metal's poison-lane widening on the store and the `[0, 1, 2]` shuffle on the read. The array
+/// pointee made the `<4 x float>` result non-bitcastable ("cannot reinterpret load ... with
+/// non-bitcastable pointee Array(Vector(Float, 3), N)"); the pre-emission carrier rewrite lowers
+/// the load to the `<3 x float>` its shuffle always selects.
+#[test]
+fn native_array3_prefix_vector4_load_narrowed_by_prefix_shuffle_reads_leading_vector() {
+    let ll = r#"
+target triple = "spirv-unknown-vulkan1.2"
+define <3 x float> @load_widened_prefix() {
+entry:
+  %buf = alloca [8 x <3 x float>], align 16
+  %alias = bitcast ptr %buf to ptr
+  %wide = load <4 x float>, ptr %alias, align 16
+  %narrow = shufflevector <4 x float> %wide, <4 x float> undef, <3 x i32> <i32 0, i32 1, i32 2>
+  ret <3 x float> %narrow
+}
+"#;
+    let asm = disassemble(&emit_vulkan_spirv(ll).expect("native emit")).expect("disassemble");
+    assert!(!asm.contains("non-bitcastable"), "{asm}");
+    // Exactly one load — of the leading `<3 x float>` element — and the shuffle is gone.
+    assert_eq!(asm.matches("OpLoad").count(), 1, "{asm}");
+    assert!(asm.contains("OpTypeVector %3 3"), "{asm}");
+    assert!(!asm.contains("OpVectorShuffle"), "{asm}");
+    assert!(!asm.contains("OpBitcast %_ptr_"), "{asm}");
+}
+
+/// The same store/load round-trip the failing fragment shaders perform, end to end: widen a
+/// `<3 x float>` (poison fourth lane), store `<4 x float>` through the array's base alias, read it
+/// back with the `<4 x float>` load + prefix shuffle, and consume the narrowed vector. Translation
+/// must succeed and produce spirv-val-clean SPIR-V.
+#[test]
+fn native_array3_prefix_vector4_store_load_roundtrip_validates() {
+    let ll = r#"
+target triple = "spirv-unknown-vulkan1.2"
+define void @sample_transition(ptr addrspace(1) %out, ptr addrspace(1) %srcbuf) {
+entry:
+  %buf = alloca [8 x <3 x float>], align 16
+  %src = load <3 x float>, ptr addrspace(1) %srcbuf, align 4
+  %wide = shufflevector <3 x float> %src, <3 x float> undef, <4 x i32> <i32 0, i32 1, i32 2, i32 poison>
+  %alias = bitcast ptr %buf to ptr
+  store <4 x float> %wide, ptr %alias, align 16
+  %read = load <4 x float>, ptr %alias, align 16
+  %value = shufflevector <4 x float> %read, <4 x float> undef, <3 x i32> <i32 0, i32 1, i32 2>
+  store <3 x float> %value, ptr addrspace(1) %out, align 4
+  ret void
+}
+
+!air.kernel = !{!0}
+!0 = !{ptr @sample_transition, !1, !2}
+!1 = !{}
+!2 = !{!3, !4}
+!3 = !{i32 0, !"air.buffer", !"air.buffer_size", i32 12, !"air.location_index", i32 0, i32 1, !"air.write", !"air.arg_type_size", i32 12, !"air.arg_type_align_size", i32 4, !"air.arg_type_name", !"float3", !"air.arg_name", !"out"}
+!4 = !{i32 1, !"air.buffer", !"air.buffer_size", i32 12, !"air.location_index", i32 1, i32 1, !"air.read", !"air.arg_type_size", i32 12, !"air.arg_type_align_size", i32 4, !"air.arg_type_name", !"float3", !"air.arg_name", !"src"}
+"#;
+    let tmp = std::env::temp_dir().join(format!(
+        "metal2vulkan_native_array3_prefix_roundtrip_{}",
+        std::process::id()
+    ));
+    let _ = std::fs::create_dir_all(&tmp);
+    let spv = crate::translate_sanitized_native(ll, Stage::Kernel, &tmp).expect("translate");
+    let asm = disassemble(&spv).expect("disassemble");
+    assert!(!asm.contains("non-bitcastable"), "{asm}");
+    assert!(asm.contains("OpLoad"), "{asm}");
+    if std::process::Command::new("spirv-val")
+        .arg("--version")
+        .output()
+        .is_ok()
+    {
+        tools::spirv_val_bytes(&spv, &tmp).expect("spirv-val");
+    }
+}
+
+/// The rewrite must not fire when the load's fourth lane is observed anywhere: the `<4 x float>`
+/// read-back keeps its (unsupported) non-bitcastable status instead of silently narrowing.
+#[test]
+fn native_array3_prefix_vector4_load_fourth_lane_use_keeps_rejection() {
+    let ll = r#"
+target triple = "spirv-unknown-vulkan1.2"
+define float @fourth_lane_read() {
+entry:
+  %buf = alloca [8 x <3 x float>], align 16
+  %alias = bitcast ptr %buf to ptr
+  %wide = load <4 x float>, ptr %alias, align 16
+  %narrow = shufflevector <4 x float> %wide, <4 x float> undef, <3 x i32> <i32 0, i32 1, i32 2>
+  %lane3 = extractelement <4 x float> %wide, i32 3
+  %first = extractelement <3 x float> %narrow, i32 0
+  %sum = fadd float %lane3, %first
+  ret float %sum
+}
+"#;
+    let error = emit_vulkan_spirv(ll)
+        .expect_err("a fourth-lane consumer must keep the load unsupported")
+        .to_string();
+    assert!(
+        error.contains("non-bitcastable pointee Array(Vector(Float, 3), 8) to Vector(Float, 4)"),
+        "{error}"
+    );
+}
+
+/// A single-use shuffle whose mask is not the prefix `[0, 1, 2]` still observes lane 3, so the
+/// rewrite must not narrow that load either.
+#[test]
+fn native_array3_prefix_vector4_load_nonprefix_shuffle_keeps_rejection() {
+    let ll = r#"
+target triple = "spirv-unknown-vulkan1.2"
+define <3 x float> @nonprefix_shuffle() {
+entry:
+  %buf = alloca [8 x <3 x float>], align 16
+  %alias = bitcast ptr %buf to ptr
+  %wide = load <4 x float>, ptr %alias, align 16
+  %shifted = shufflevector <4 x float> %wide, <4 x float> undef, <3 x i32> <i32 1, i32 2, i32 3>
+  ret <3 x float> %shifted
+}
+"#;
+    let error = emit_vulkan_spirv(ll)
+        .expect_err("a non-prefix mask must keep the load unsupported")
+        .to_string();
+    assert!(
+        error.contains("non-bitcastable pointee Array(Vector(Float, 3), 8) to Vector(Float, 4)"),
+        "{error}"
+    );
+}
+
+/// Ordinary array-of-`<3 x float>` loads keep their existing shape: the leading-vector aggregate
+/// path emits an access chain to element 0 and one direct `OpLoad`, with no reinterpret noise.
+#[test]
+fn native_array3_vector3_load_unchanged() {
+    let ll = r#"
+target triple = "spirv-unknown-vulkan1.2"
