+/// Rewrite a `<4 x T>` load that reads back the leading `<3 x T>` element of an
+/// `Array(Vector(T, 3), N)` allocation, when the load's only consumer is a `[0, 1, 2]` shuffle.
+///
+/// Metal codegen stores a `<3 x T>` vector by widening it to `<4 x T>` with a poison fourth lane,
+/// and reads it back as a `<4 x T>` load immediately narrowed by a `shufflevector` selecting lanes
+/// `[0, 1, 2]`. The pointer's recorded logical pointee stays the declared `Array(Vector(T, 3), N)`,
+/// so the emitter cannot reinterpret the `<4 x T>` result against that pointee and translation
+/// fails ("cannot reinterpret load ... non-bitcastable pointee").
+///
+/// The rewrite replaces the load with a `<3 x T>` load at the same pointer (same result name, same
+/// alignment), removes the now-use-free shuffle, and redirects every use of the shuffle's result to
+/// the load through the typed carrier rename. Lanes 0-2 are the same values at the same address;
+/// the only lane dropped is the poison one the widening introduced, which the shuffle already
+/// discards. The rewritten `<3 x T>` load from the array pointee then flows through the existing
+/// leading-vector aggregate load path.
+///
+/// Preconditions, all verified on the typed carriers:
+/// * the load's pointer is a local that resolves through identity pointer bitcasts ONLY to the
+///   `alloca` of `Array(Vector(T, 3), N)` with the load's element type `T` matching exactly and
+///   `N >= 1` — the declared layout, never an inferred view;
+/// * the parsed load payload is present and agrees with the carrier's resolved result type and
+///   alignment — a `volatile`/`atomic` spelling puts its keyword before the loaded type, which
+///   breaks `parse_load`, so a present consistent payload proves the load is neither;
+/// * the load's result has exactly ONE use, the `shufflevector` whose operand 0 is the load result
+///   (mask indices below 4 select operand-0 lanes only, so the second operand is irrelevant), with
+///   result type `<3 x T>`, appearing after the load in the finalized block order.
+///
+/// Any other shape — a fourth-lane consumer, a non-`[0, 1, 2]` mask, a non-alloca pointer
+/// provenance, mismatched element types — keeps its previous fail-visible status. A module with no
+/// `<4 x T>` load returns before allocating: this pointee/result combination has no emission path
+/// today, so the rewrite is inert on every already-translating module.
+pub(in crate::native) fn rewrite_array3_prefix_vector4_loads(
+    blocks: &mut [crate::native::cfg::BodyBlock],
+) {
+    let has_vector4_load = blocks.iter().any(|block| {
+        block.typed.as_ref().is_some_and(|typed| {
+            typed.insts.iter().any(|inst| {
+                inst.opcode == TirOpcode::Load
+                    && matches!(inst.result_ty, Some(LlType::Vector(_, 4)))
+            })
+        })
+    });
+    if !has_vector4_load {
+        return;
+    }
+
+    let mut alloca_pointees: HashMap<String, LlType> = HashMap::new();
+    let mut identity_aliases: HashMap<String, String> = HashMap::new();
+    let mut use_counts: HashMap<String, u32> = HashMap::new();
+    // Prefix-shuffle candidates keyed by their operand-0 SSA name: (block, instruction, result).
+    let mut prefix_shuffles: HashMap<String, (usize, usize, String)> = HashMap::new();
+    for (block_index, block) in blocks.iter().enumerate() {
+        let Some(typed) = block.typed.as_ref() else {
+            continue;
+        };
+        for (inst_index, inst) in typed.insts.iter().enumerate() {
+            if let TirInstData::Alloca(Some(pointee)) = &inst.data.payload {
+                if let Some(result) = &inst.result {
+                    alloca_pointees.insert(result.clone(), pointee.clone());
+                }
+            }
+            if let Some((result, base)) = inst.identity_ptr_bitcast() {
+                identity_aliases.insert(result.to_string(), base.to_string());
+            }
+            if inst.opcode == TirOpcode::ShuffleVector
+                && inst
+                    .shuffle_mask()
+                    .as_ref()
+                    .is_some_and(|(lanes, mask)| *lanes == 3 && mask.as_slice() == [0, 1, 2])
+            {
+                let operand0 = inst.operands.first().and_then(|operand| match operand {
+                    TirOperand::Value { name, .. } => Some(name.clone()),
+                    _ => None,
+                });
+                if let (Some(result), Some(operand0)) = (&inst.result, operand0) {
+                    prefix_shuffles.insert(operand0, (block_index, inst_index, result.clone()));
+                }
+            }
+            inst.visit_uses(|name| {
+                *use_counts.entry(name.to_string()).or_default() += 1;
+            });
+        }
+        // Terminators are uses too — the same set `prune_unused_geps` counts.
+        match &typed.terminator {
+            TirTerminator::BrCond { cond, .. } => {
+                *use_counts.entry(cond.clone()).or_default() += 1;
+            }
+            TirTerminator::Switch { selector, .. } => {
+                *use_counts.entry(selector.clone()).or_default() += 1;
+            }
+            TirTerminator::Ret(Some(value)) => {
+                *use_counts.entry(value.clone()).or_default() += 1;
+            }
+            _ => {}
+        }
+    }
+
+    struct LoadRewrite {
+        load_block: usize,
+        load_inst: usize,
+        shuffle_block: usize,
+        shuffle_inst: usize,
+        vector3_ty: LlType,
+        shuffle_result: String,
+        load_result: String,
+    }
+    let mut rewrites = Vec::new();
+    for (load_block, block) in blocks.iter().enumerate() {
+        let Some(typed) = block.typed.as_ref() else {
+            continue;
+        };
+        for (load_inst, inst) in typed.insts.iter().enumerate() {
+            if inst.opcode != TirOpcode::Load {
+                continue;
+            }
+            let Some(load_result) = &inst.result else {
+                continue;
+            };
+            let (Some(result_ty), Some(load)) = (&inst.result_ty, inst.load().as_deref()) else {
+                continue;
+            };
+            let LlType::Vector(elem, 4) = result_ty else {
+                continue;
+            };
+            let elem = (**elem).clone();
+            if load.result_ty != *result_ty || load.align != inst.mem_align() {
+                continue;
+            }
+            let LlValue::Local(ptr_name) = &load.ptr.value else {
+                continue;
+            };
+            if !inst.operands.first().is_some_and(
+                |operand| matches!(operand, TirOperand::Value { name, .. } if name == ptr_name),
+            ) {
+                continue;
+            }
+            // The declared array-of-vector3 layout: resolve the pointer through identity bitcasts
+            // only, down to the `alloca` whose allocated type IS that layout.
+            let mut root = ptr_name.clone();
+            let mut visited = HashSet::new();
+            while visited.insert(root.clone()) {
+                match identity_aliases.get(&root) {
+                    Some(base) => root = base.clone(),
+                    None => break,
+                }
+            }
+            let Some(LlType::Array(element, count)) = alloca_pointees.get(&root) else {
+                continue;
+            };
+            if *count == 0 {
+                continue;
+            }
+            let LlType::Vector(element_lanes, 3) = &**element else {
+                continue;
+            };
+            if **element_lanes != elem {
+                continue;
+            }
+            // Exactly one use, and that use is the prefix shuffle.
+            if use_counts.get(load_result) != Some(&1) {
+                continue;
+            }
+            let Some((shuffle_block, shuffle_inst, shuffle_result)) =
+                prefix_shuffles.get(load_result.as_str())
+            else {
+                continue;
+            };
+            let (shuffle_block, shuffle_inst, shuffle_result) =
+                (*shuffle_block, *shuffle_inst, shuffle_result.clone());
+            let shuffle_result_ty = blocks
+                .get(shuffle_block)
+                .and_then(|block| block.typed.as_ref())
+                .and_then(|typed| typed.insts.get(shuffle_inst))
+                .and_then(|inst| inst.result_ty.clone());
+            if shuffle_result_ty != Some(LlType::Vector(Box::new(elem.clone()), 3)) {
+                continue;
+            }
+            // Def-before-use in the finalized block order: the load precedes its single consumer.
+            if shuffle_block < load_block
+                || (shuffle_block == load_block && shuffle_inst < load_inst)
+            {
+                continue;
+            }
+            rewrites.push(LoadRewrite {
+                load_block,
+                load_inst,
+                shuffle_block,
+                shuffle_inst,
+                vector3_ty: LlType::Vector(Box::new(elem), 3),
+                shuffle_result,
+                load_result: load_result.clone(),
+            });
+        }
+    }
+    if rewrites.is_empty() {
+        return;
+    }
+
+    let mut shuffle_removals: HashMap<usize, Vec<usize>> = HashMap::new();
+    let mut renames: HashMap<String, String> = HashMap::new();
+    for rewrite in &rewrites {
+        let vector3_ty = rewrite.vector3_ty.clone();
+        let load_result = rewrite.load_result.clone();
+        if let Some(inst) = blocks
+            .get_mut(rewrite.load_block)
+            .and_then(|block| block.typed_mut())
+            .and_then(|typed| typed.insts.get_mut(rewrite.load_inst))
+        {
+            inst.result_ty = Some(vector3_ty.clone());
+            if let TirInstData::Memory { load, .. } = &mut inst.data.payload {
+                if let Some(load) = load.as_mut() {
+                    load.result_ty = vector3_ty;
+                }
+            }
+        }
+        shuffle_removals
+            .entry(rewrite.shuffle_block)
+            .or_default()
+            .push(rewrite.shuffle_inst);
+        renames.insert(rewrite.shuffle_result.clone(), load_result);
+    }
+    for (block_index, mut indices) in shuffle_removals {
+        indices.sort_unstable();
+        indices.dedup();
+        if let Some(typed) = blocks
+            .get_mut(block_index)
+            .and_then(|block| block.typed_mut())
+        {
+            for index in indices.into_iter().rev() {
+                typed.insts.remove(index);
+            }
+        }
+    }
+    for block in blocks.iter_mut() {
+        if let Some(typed) = block.typed_mut() {
+            typed.rename(&renames);
+        }
+    }
+}
